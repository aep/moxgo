  "rules": [
    {
      "comment": "Linux x86_64: Microsoft's ONNX Runtime",
      "match": {
        "os": "linux",
        "arch": "amd64"
      },
      "runtime": {
        "core": "onnxruntime-linux-x64-1.29.0/libonnxruntime.so"
      }
    },
    {
      "comment": "Linux aarch64: Microsoft's ONNX Runtime",
      "match": {
        "os": "linux",
        "arch": "arm64"
      },
      "runtime": {
        "core": "onnxruntime-linux-arm64-1.29.0/libonnxruntime.so"
      }
    },
    {
      "comment": "macOS arm64: Microsoft's ONNX Runtime, CoreML first",
      "match": {
        "os": "darwin",
        "arch": "arm64"
      },
      "runtime": {
        "core": "onnxruntime-macos-arm64-1.29.0/libonnxruntime.dylib",
        "eps": [
          {
            "name": "CoreML"
          }
        ]
      }
    },
    {
      "comment": "Windows x64: Microsoft's ONNX Runtime",
      "match": {
        "os": "windows",
        "arch": "amd64"
      },
      "runtime": {
        "core": "onnxruntime-windows-x64-1.29.0/onnxruntime.dll"
      }
    },
    {
      "comment": "Android arm64: Microsoft's ONNX Runtime on the CPU (NNAPI reaches a vendor NPU on few phones and is slower than the CPU on the rest; XNNPACK is no faster than ORT's CPU kernels and cannot run int8 models' quantized softmax)",
      "match": {
        "os": "android",
        "arch": "arm64"
      },
      "runtime": {
        "core": "onnxruntime-android-arm64-1.29.0/libonnxruntime.so",
        "eps": []
      }
    },
    {
      "comment": "Qualcomm Snapdragon: Qualcomm's QNN plugin on the HTP (NPU), else the CPU. The HTP library picks the stub of the phone's Hexagon generation by name, so all stubs are preloaded; the NPU loads the matching skel from ADSP_LIBRARY_PATH",
      "match": {
        "os": "android",
        "arch": "arm64",
        "soc.manufacturer": "QTI"
      },
      "runtime": {
        "plugins": {
          "QNN": "onnxruntime-qnn-android-2.7.0/libonnxruntime_providers_qnn.so"
        },
        "preload": [
          "qnn-htp-android-2.51.0/libQnnSystem.so",
          "qnn-htp-android-2.51.0/libQnnHtpPrepare.so",
          "qnn-htp-android-2.51.0/libQnnHtp.so",
          "qnn-htp-android-2.51.0/libQnnHtpV68Stub.so",
          "qnn-htp-android-2.51.0/libQnnHtpV69Stub.so",
          "qnn-htp-android-2.51.0/libQnnHtpV73Stub.so",
          "qnn-htp-android-2.51.0/libQnnHtpV75Stub.so",
          "qnn-htp-android-2.51.0/libQnnHtpV79Stub.so",
          "qnn-htp-android-2.51.0/libQnnHtpV81Stub.so"
        ],
        "env": {
          "ADSP_LIBRARY_PATH": "${pkg:qnn-htp-android-2.51.0}"
        },
        "eps": [
          {
            "name": "QNN",
            "options": {
              "backend_path": "${pkg:qnn-htp-android-2.51.0}/libQnnHtp.so"
            }
          }
        ]
      }
    }
  ]
}
